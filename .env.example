# Copy to .env (or .env.local) and edit as needed. Both are gitignored.
# Pydantic-settings (app/config.py) reads .env then .env.local; latter wins.

# SQLAlchemy connection URL. Must match the docker-compose postgres unless you
# point at a different database.
DATABASE_URL=postgresql+psycopg://bastion:bastion@127.0.0.1:5432/bastion

# Used only by docker-compose to provision the container. The app itself reads
# DATABASE_URL above, not these.
POSTGRES_USER=bastion
POSTGRES_PASSWORD=bastion
POSTGRES_DB=bastion
POSTGRES_PORT=5432

# PyPI-compatible package registry, read by `make publish-client` /
# `make release-*`. Shell env overrides .env.
#
# Forgejo example:
# PYTHON_PACKAGE_REGISTRY_URL=https://forgejo.example.lan/api/packages/your-owner/pypi
# PYTHON_PACKAGE_REGISTRY_USERNAME=your-owner
#
# Other registries can use the same variables with their upload endpoint and
# token username convention. If PYTHON_PACKAGE_REGISTRY_USERNAME is omitted,
# `make publish-client` uses "__token__".
PYTHON_PACKAGE_REGISTRY_URL=
PYTHON_PACKAGE_REGISTRY_USERNAME=
PYTHON_PACKAGE_REGISTRY_TOKEN=

# Container registry, read by `make publish-container`. Works with Docker Hub,
# Forgejo, GHCR, or any registry that supports `docker login`. Shell env overrides .env.
#
# Docker Hub example:
# CONTAINER_REGISTRY_URL=docker.io
# CONTAINER_REGISTRY_NAMESPACE=your-dockerhub-user
# CONTAINER_REGISTRY_USERNAME=your-dockerhub-user
# CONTAINER_REGISTRY_TOKEN=
#
# Forgejo example:
# CONTAINER_REGISTRY_URL=vcs.example.com
# CONTAINER_REGISTRY_NAMESPACE=example
# CONTAINER_REGISTRY_USERNAME=example
# CONTAINER_REGISTRY_TOKEN=
CONTAINER_REGISTRY_URL=
CONTAINER_REGISTRY_NAMESPACE=
CONTAINER_REGISTRY_USERNAME=
CONTAINER_REGISTRY_TOKEN=
